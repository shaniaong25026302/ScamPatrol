# <Shania Start>
# ── scamlah environment ──────────────────────────────────────────
# Copy this file to ".env" and fill in real values. NEVER commit .env.

# App
PORT=3000
NODE_ENV=development

# MySQL (the running DB this app connects to)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
# Filess.io free tier caps total connections at 5 (max_user_connections). Keep low.
DB_CONNECTION_LIMIT=3

# Auth — JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Scam Checker — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Email (password reset) — Gmail SMTP.
# SMTP_PASS is a Google "App Password" (16 chars), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=scamlah <your-gmail-address@gmail.com>
# Base URL used to build reset links in emails (use the Render URL in production).
APP_BASE_URL=http://localhost:3000
# <Shania End>
