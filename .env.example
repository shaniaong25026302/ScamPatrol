# ── scamlah environment ──────────────────────────────────────────
# Copy this file to ".env" and fill in real values. NEVER commit .env.

# App
PORT=3000
NODE_ENV=development

# MySQL (the running DB this app connects to)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
# Filess.io free tier limits concurrent connections — keep this small (<=5).
DB_CONNECTION_LIMIT=4

# Auth — JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# AI Scam Checker — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
