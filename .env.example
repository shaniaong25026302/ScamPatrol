# ============================================================================
# Scam Patrol — configuration contract
#
# Copy this file to .env and fill in the blanks. .env is gitignored and must NEVER
# be committed: this repository is public.
#
# This file is the contract. Every teammate's container, compose file and Ansible
# template is written against these names, so it lists EVERY variable the app reads,
# not just the ones you happen to need locally. CI enforces that mechanically: the
# "Check .env.example still matches what the app reads" step in ci.yml fails the
# build if src/ reads a name that is missing here, or if a name here is read by
# nothing. Both directions, because a contract that drifts either way is worse than
# no contract at all.
#
# Nothing here is baked into the image. In production every value is injected at
# runtime from GitHub Secrets and Variables, which is why the credential fields
# below are left blank rather than filled with a plausible-looking default.
#
# Marked (required) or (optional). Optional means the app has a sensible built-in
# default and will start without it.
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
PORT=3000                                  # (optional) port to listen on. Default 3000.
NODE_ENV=development                       # (optional) development | production | test.
APP_BASE_URL=http://localhost:3000         # (required in production) public URL of the
                                           # app. Password-reset emails build their links
                                           # from this, so if it is wrong the links point
                                           # somewhere nobody can reach.

# ── Database (MySQL 8) ───────────────────────────────────────────────────────
DB_HOST=localhost                          # (required)
DB_PORT=3306                               # (optional) default 3306.
DB_USER=root                               # (required)
DB_PASSWORD=                               # (required) leave blank here. Never commit one.
DB_NAME=scampatrol                         # (required)
DB_CONNECTION_LIMIT=4                      # (optional) default 4. Keep it low: the shared
                                           # database host allows only a handful of
                                           # connections, and exceeding it fails every
                                           # query at once rather than queueing.

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change_this_for_local_dev       # (required) signs the login cookie. In
                                           # production this comes from GitHub Secrets and
                                           # must be long and random. Changing it logs
                                           # everyone out, which is the correct response to
                                           # a suspected leak.
JWT_EXPIRES_IN=24h                         # (optional) access token lifetime.
JWT_REFRESH_EXPIRES_IN=7d                  # (optional) refresh token lifetime.
COOKIE_SECURE=                             # (optional) 1 or 0. Blank means "secure when
                                           # NODE_ENV=production", which is correct only if
                                           # production is HTTPS. Our EC2 demo box serves
                                           # plain HTTP, so it needs COOKIE_SECURE=0 or the
                                           # browser silently discards the login cookie and
                                           # every user appears logged out. Set back to 1
                                           # the moment TLS is in front of the app.

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=                            # (required unless AI_FAKE=1) from
                                           # aistudio.google.com. Free tier quota is scoped
                                           # per project AND per model.
GEMINI_MODEL=gemini-2.5-flash              # (optional) default gemini-2.5-flash.
AI_FAKE=0                                  # (optional) 1 = answer every AI request from the
                                           # built-in offline heuristics and never call the
                                           # API. CI always sets 1, so the pipeline needs no
                                           # key and burns no quota.

# ── Email (password reset) ───────────────────────────────────────────────────
# Two transports. Mailjet's API is tried first; SMTP is the fallback.
MAIL_FROM=                                 # (required to send mail) the From address. Must
                                           # be verified with the provider.
MAILJET_API_KEY=                           # (optional) Mailjet API path.
MAILJET_SECRET_KEY=                        # (optional) pairs with the key above.
SMTP_HOST=                                 # (optional) SMTP fallback.
SMTP_PORT=587                              # (optional) 587 for STARTTLS, 465 for TLS.
SMTP_USER=                                 # (optional)
SMTP_PASS=                                 # (optional) an app password, never the account
                                           # password.

# ── Scam Weather ─────────────────────────────────────────────────────────────
SCAM_WEATHER_REFRESH_MINUTES=30            # (optional) how often to refresh the feed.
SCAM_WEATHER_SOURCE_TIMEOUT_MS=7000        # (optional) give up on a slow source after this.
