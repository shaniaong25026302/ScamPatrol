<%# <Shawn Start> %>

<div class="py-4">

    <h1 class="mb-3">📖 Scam Glossary</h1>

    <p class="text-muted">
        Learn about common scam types, how they work, and how you can protect yourself.
    </p>

    <div class="row mb-4">

        <div class="col-md-8">

            <input
                type="text"
                id="glossary-search"
                class="form-control"
                placeholder="🔍 Search scam types...">

        </div>

        <div class="col-md-4">

            <select
                id="glossary-filter"
                class="form-select">

                <option value="all">📂 All Categories</option>
                <option value="phishing">Phishing</option>
                <option value="investment">Investment</option>
                <option value="romance">Romance</option>
                <option value="banking">Banking</option>
                <option value="government">Government</option>
                <option value="job">Job</option>
                <option value="e-commerce">E-Commerce</option>
                <option value="general">General</option>

            </select>

        </div>

    </div>

    <p id="no-results" class="text-muted" style="display:none;">
        No matching scam types found.
    </p>

    <% glossary.forEach(item => { %>

        <div
            class="card mb-3 glossary-card"
            data-term="<%= item.term.toLowerCase() %>"
            data-description="<%= item.description.toLowerCase() %>"
            data-category="<%= item.category.toLowerCase() %>">

            <div class="card-body">

                <span class="badge bg-primary mb-2">
                    <%= item.category %>
                </span>

                <h4>📚 <%= item.term %></h4>

                <p>
                    <%= item.description %>
                </p>

                <strong>Prevention:</strong>

                <ul>
                    <li><%= item.prevention %></li>
                </ul>

            </div>

        </div>

    <% }) %>

</div>

<script>

const search = document.getElementById("glossary-search");
const filter = document.getElementById("glossary-filter");
const noResults = document.getElementById("no-results");

function filterGlossary() {

    const keyword = search.value.toLowerCase();
    const category = filter.value.toLowerCase();

    let found = false;

    document.querySelectorAll(".glossary-card").forEach(card => {

        const term = card.dataset.term;
        const description = card.dataset.description;
        const cardCategory = card.dataset.category;

        const matchesSearch =
            term.includes(keyword) ||
            description.includes(keyword);

        const matchesCategory =
            category === "all" ||
            cardCategory === category;

        if (matchesSearch && matchesCategory) {

            card.style.display = "";
            found = true;

        } else {

            card.style.display = "none";

        }

    });

    noResults.style.display = found ? "none" : "block";

}

search.addEventListener("input", filterGlossary);
filter.addEventListener("change", filterGlossary);

</script>

<%# <Shawn End> %>