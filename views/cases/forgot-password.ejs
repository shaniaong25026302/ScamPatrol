<%# <Shania Start> %>
<%#
  FILE: views/auth/forgot-password.ejs
  The "Forgot password" page. Driven by public/js/auth.js (#forgot-form), which posts the email to
  POST /api/auth/forgot-password. The success banner (#form-success) is where auth.js shows the
  "check your email" message — or, if email delivery is unavailable, a direct reset link.
%>
<div class="card auth-card">
  <h1>Forgot password</h1>
  <p class="sub">Enter your email and we'll send a reset link.</p>

  <div class="alert alert-danger" id="form-error" style="display:none"></div> <%# error banner %>
  <div class="alert alert-success" id="form-success" style="display:none"></div> <%# success / reset-link banner %>

  <form id="forgot-form" novalidate>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required />
      <div class="field-error" data-for="email"></div>
    </div>
    <button type="submit" class="btn btn-primary" style="width:100%">Send reset link</button>
  </form>

  <p class="form-foot"><a href="/auth/login">Back to log in</a></p>
</div>

<script src="/js/auth.js" defer></script>
<%# <Shania End> %>
