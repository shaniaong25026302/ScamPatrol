<%# <Shania Start> %>
<section class="gw-hero">
  <img src="/img/owl-mentor.png?v=2" class="owl pixel" alt="Inspector Hoot" />
  <div><h1>🥋 The Dojo</h1><p>Roast lazy scams and study the villains you'll face in the wild.</p></div>
</section>

<div class="gw-grid">
  <section class="panel col-7">
    <h2>🔥 Roast-the-Scam</h2>
    <p class="muted" style="margin-top:-0.4rem">Paste a scam and let Inspector Hoot roast it — the jokes <em>are</em> the red-flag lesson.</p>
    <textarea id="roast-text" rows="5" placeholder="Paste a scam message to roast..."></textarea>
    <div class="center" style="color:var(--gw-red);font-size:.85rem;min-height:1rem" id="roast-error"></div>
    <button class="gw-btn gold" id="roast-submit">🔥 Roast it</button>

    <div class="gw-result" id="roast-result" style="display:none">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0">Scam Quality Score</h3>
        <div class="streak-big" id="roast-score" style="font-size:2.4rem">–</div>
      </div>
      <p id="roast-out" style="font-style:italic;color:var(--gw-cyan)"></p>
      <ul class="gw-signals" id="roast-flags"></ul>
    </div>
  </section>

  <aside class="panel col-5">
    <h2>👾 Scammer Villains</h2>
    <div class="villains">
      <div class="villain"><img src="/img/villains/fakebank.png" class="villain-img" alt="Mr. FakeBank" /><div class="nm">Mr. FakeBank</div><div class="lvl">Phishing</div></div>
      <div class="villain"><img src="/img/villains/parcel.png" class="villain-img" alt="Parcel Trickster" /><div class="nm">Parcel Trickster</div><div class="lvl">Delivery</div></div>
      <div class="villain"><img src="/img/villains/loveliar.png" class="villain-img" alt="Love Liar" /><div class="nm">Love Liar</div><div class="lvl">Romance</div></div>
      <div class="villain"><img src="/img/villains/crypto.png" class="villain-img" alt="Crypto Conman" /><div class="nm">Crypto Conman</div><div class="lvl">Investment</div></div>
    </div>
    <p class="muted center" style="margin-top:1rem">Full roleplay battles with each villain are coming soon.</p>
    <a href="/hq" class="gw-btn ghost" style="margin-top:.6rem;width:100%">← Back to HQ</a>
  </aside>
</div>

<script src="/js/game-roast.js" defer></script>
<%# <Shania End> %>
