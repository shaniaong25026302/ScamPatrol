<%# <Shania Start> %>
<section class="gw-hero">
  <%- include('../partials/owl-mascot', { owlClass: '' }) %>
  <div><h1>🎯 Field Missions</h1><p>Spot the scam. Earn XP. Climb the ranks.</p></div>
</section>

<div class="gw-grid">
  <section class="panel col-8" id="mission-panel">
    <h2>Mission: <span id="m-kind">…</span></h2>
    <div class="gw-result" id="m-content">Loading mission…</div>
    <div id="m-actions" style="margin-top:1rem">
      <button class="gw-btn safe" data-ans="legit">🛡️ Safe</button>
      <button class="gw-btn danger" data-ans="scam">🚨 Scam</button>
    </div>
    <div class="gw-result" id="m-feedback" style="display:none"></div>
    <button class="gw-btn gold" id="m-next" style="display:none;margin-top:1rem">Next mission →</button>
  </section>

  <aside class="panel col-4 center">
    <h2>📊 This Run</h2>
    <div class="streak-big" id="m-score">0</div>
    <div class="muted">missions cleared</div>
    <p class="muted" style="margin-top:1rem">Clear 10 missions to earn the <b>🎖️ Sharpshooter</b> badge.</p>
    <a href="/hq" class="gw-btn ghost" style="margin-top:1rem">← Back to HQ</a>
  </aside>
</div>

<script src="/js/game-missions.js" defer></script>
<%# <Shania End> %>
