<%# <Shania Start> %>
<section class="gw-hero">
  <img src="/img/owl-mentor.png?v=2" class="owl pixel" alt="Inspector Hoot" />
  <div><h1>🏆 World Leaderboard</h1><p>The top scam patrollers across Scam Patrol.</p></div>
</section>

<div class="gw-grid">
  <section class="panel col-8">
    <div class="lb-tabs">
      <button class="lb-tab active" data-type="score">Score</button>
      <button class="lb-tab" data-type="streak">Streak</button>
    </div>
    <table class="lb"><tbody id="lb-body"><tr><td class="muted">Loading…</td></tr></tbody></table>
  </section>

  <aside class="panel col-4 center">
    <h2>Your Standing</h2>
    <div class="streak-big" id="lb-rank">–</div>
    <div class="muted">global rank</div>
    <div style="margin-top:1rem"><span class="gw-chip"><span class="lvl">Lv <b id="lb-mylevel">–</b></span></span></div>
    <a href="/hq" class="gw-btn ghost" style="margin-top:1.2rem">← Back to HQ</a>
  </aside>
</div>

<script src="/js/game-leaderboard.js" defer></script>
<%# <Shania End> %>
