<%# <Shania Start> %>
<div class="card auth-card">
  <h1>Reset password</h1>
  <p class="sub">Choose a new password for your account.</p>

  <div class="alert alert-danger" id="form-error" style="display:none"></div>
  <div class="alert alert-success" id="form-success" style="display:none"></div>

  <form id="reset-form" novalidate>
    <input type="hidden" id="token" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>" />
    <div class="form-group">
      <label for="password">New password</label>
      <div class="pw-wrap">
        <input type="password" id="password" name="password" autocomplete="new-password" required />
        <button type="button" class="pw-eye" aria-label="Show password">👁</button>
      </div>
      <div class="field-error" data-for="password"></div>
    </div>
    <div class="form-group">
      <label for="confirmPassword">Confirm new password</label>
      <div class="pw-wrap">
        <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required />
        <button type="button" class="pw-eye" aria-label="Show password">👁</button>
      </div>
      <div class="field-error" data-for="confirmPassword"></div>
    </div>
    <button type="submit" class="btn btn-primary" style="width:100%">Update password</button>
  </form>

  <p class="form-foot"><a href="/auth/login">Back to log in</a></p>
</div>

<script src="/js/auth.js" defer></script>
<%# <Shania End> %>
