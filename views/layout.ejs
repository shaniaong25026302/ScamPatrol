<%# <Shania Start> %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Scam Patrol HQ' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/game.css?v=4" />
  <link rel="icon" href="/img/logo-cropped.png?v=3" />
</head>
<body class="game-world">

  <%- include('partials/game-nav', { activePage: typeof activePage !== 'undefined' ? activePage : '' }) %>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-<%= flash.category || 'warning' %>">⚠️ <%= flash.message %></div>
  <% } %>

  <main class="game-main">
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <div id="gw-overlay" class="gw-overlay"><div class="gw-modal" id="gw-modal"></div></div>
  <div id="xp-toast" class="xp-toast" aria-live="polite"></div>
  <script src="/js/main.js" defer></script>
  <script src="/js/sound.js" defer></script>
  <script src="/js/game-hud.js" defer></script>
  <script src="/js/spa.js" defer></script>
</body>
</html>
<%# <Shania End> %>
