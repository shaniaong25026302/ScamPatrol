<%- include('partials/header', { title: 'scamlah', activePage: 'home' }) %>

<main class="container">
  <section class="hero">
    <h1><span class="scam">scam</span><span class="lah">lah</span></h1>
    <p>Leaderboard and community points are back. Help the community spot scams and climb the rankings.</p>
    <a href="/leaderboard" class="btn btn-primary">View leaderboard</a>
  </section>

  <section class="grid home-preview">
    <div class="card">
      <h2>Points leaderboard</h2>
      <p>The community leaderboard rewards users for case reports, comments, and scam verification.</p>
      <% const previewLeaderboard = Array.isArray(leaderboard) ? leaderboard : []; %>
      <% if (previewLeaderboard.length) { %>
        <ul class="leaderboard-preview-list">
          <% previewLeaderboard.forEach((user) => { %>
            <li><strong><%= user.username %></strong> — <%= user.points %> points</li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No leaderboard data yet.</p>
      <% } %>
    </div>

    <div class="card">
      <h2>Ready to earn badges?</h2>
      <p>Your contributions now show up on the leaderboard as points accumulate. Stay visible and keep helping.</p>
      <a href="/leaderboard" class="btn btn-ghost">Open leaderboard</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
