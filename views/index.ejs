<%- include('partials/header', { title: 'scamlah', activePage: 'home' }) %>

<main class="container">
  <section class="hero">
    <h1><span class="scam">scam</span><span class="lah">lah</span></h1>
    <p>Report. Check. Stay safe.</p>
    <div class="hero-actions">
      <a href="/leaderboard" class="btn btn-primary">View leaderboard</a>
      <a href="/api/points/config" class="btn btn-ghost">View points API config</a>
    </div>
  </section>

  <section class="grid home-preview">
    <div class="card">
      <h2>Points leaderboard</h2>
      <p>The community leaderboard rewards users for case reports, comments, and scam verification.</p>
      <% const previewLeaderboard = Array.isArray(leaderboard) ? leaderboard : []; %>
      <% if (previewLeaderboard.length) { %>
        <ul class="leaderboard-preview-list">
          <% previewLeaderboard.forEach((user, index) => { %>
            <li>
              <span>#<%= index + 1 %></span>
              <strong><%= user.username %></strong>
              <em><%= user.points %> points</em>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No leaderboard data yet.</p>
      <% } %>
    </div>

    <div class="card">
      <h2>Badge milestones</h2>
      <p>Users unlock badges for signing up, submitting reports, posting comments, and earning points.</p>
      <a href="/leaderboard" class="btn btn-ghost">Open badge path</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
