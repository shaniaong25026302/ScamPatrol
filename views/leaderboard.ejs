<%- include('partials/header', { title: 'ScamLah Leaderboard', activePage: 'leaderboard' }) %>

<main class="container leaderboard-page">
  <section class="leaderboard-hero card">
    <div>
      <p class="eyebrow">Community reputation</p>
      <h1>🏆 ScamLah Leaderboard</h1>
      <p>
        Top contributors are ranked by points. Users earn points by submitting scam reports,
        posting useful comments, and helping the community verify suspicious activity.
      </p>
    </div>
  </section>

  <section class="points-guide">
    <h2>How points are earned</h2>
    <div class="points-grid">
      <article class="points-card">
        <strong>+<%= pointsConfig.pointValues.REPORT_SUBMITTED %></strong>
        <span>Submit scam report</span>
      </article>
      <article class="points-card">
        <strong>+<%= pointsConfig.pointValues.COMMENT_POSTED %></strong>
        <span>Post comment</span>
      </article>
      <article class="points-card">
        <strong>+<%= pointsConfig.pointValues.CASE_VERIFIED %></strong>
        <span>Case verified</span>
      </article>
      <article class="points-card">
        <strong>+<%= pointsConfig.pointValues.UPVOTE_RECEIVED %></strong>
        <span>Receive upvote</span>
      </article>
    </div>
  </section>

  <section class="leaderboard-card card">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Rankings</p>
        <h2>Top Contributors</h2>
      </div>
      <span class="pill"><%= leaderboard.length %> users tracked</span>
    </div>

    <div class="table-wrap">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>User</th>
            <th>Points</th>
            <th>Reports</th>
            <th>Comments</th>
            <th>Badges</th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.forEach((user, index) => { %>
            <tr>
              <td class="rank-cell">
                <% if (index === 0) { %>🥇<% } else if (index === 1) { %>🥈<% } else if (index === 2) { %>🥉<% } else { %>#<%= index + 1 %><% } %>
              </td>
              <td>
                <strong><%= user.username %></strong>
              </td>
              <td><strong><%= user.points %></strong></td>
              <td><%= user.reportCount %></td>
              <td><%= user.commentCount %></td>
              <td>
                <% if (user.badges && user.badges.length > 0) { %>
                  <div class="badge-row">
                    <% user.badges.forEach((badge) => { %>
                      <span class="badge-chip" title="<%= badge.description %>">
                        <span><%= badge.icon %></span>
                        <span><%= badge.name %></span>
                      </span>
                    <% }) %>
                  </div>
                <% } else { %>
                  <span class="no-badge">No badges yet</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="badge-milestones card">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Badge path</p>
        <h2>Milestones users can unlock</h2>
      </div>
    </div>

    <div class="badge-grid">
      <% pointsConfig.badgeDefinitions.forEach((badge) => { %>
        <article class="badge-card">
          <div class="badge-icon"><%= badge.icon %></div>
          <div>
            <h3><%= badge.name %></h3>
            <p><%= badge.description %></p>
            <span class="badge-meta"><%= badge.category %> · <%= badge.metric %> ≥ <%= badge.threshold %></span>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
