<h1>Scam Glossary</h1>

<a href="/admin/glossary/new" class="btn btn-primary">
    Add New Entry
</a>

<hr>

<table class="table">

<tr>
    <th>Term</th>
    <th>Description</th>
    <th>Prevention</th>
</tr>

<% glossary.forEach(item => { %>

<tr>

<td><%= item.term %></td>

<td><%= item.description %></td>

<td><%= item.prevention %></td>

</tr>

<% }) %>

</table>