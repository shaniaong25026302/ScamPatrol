<%# <Shawn Start> %>

<h1>Verify Scam Cases</h1>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Platform</th>
        <th>Status</th>
        <th>Helpful</th>
        <th>Flags</th>
        <th>Action</th>
    </tr>

    <% cases.forEach(scamCase => { %>

        <tr>

            <td><%= scamCase.id %></td>
            <td><%= scamCase.title %></td>
            <td><%= scamCase.category_name || "N/A" %></td>
            <td><%= scamCase.platform || "N/A" %></td>
            <td><%= scamCase.status %></td>
            <td><%= scamCase.helpful_count %></td>
            <td><%= scamCase.flag_count %></td>

            <td>

                <form
                    action="/admin/cases/approve/<%= scamCase.id %>"
                    method="POST"
                    style="display:inline;">

                    <button type="submit" class="btn btn-success btn-sm">
                        ✅ Approve
                    </button>

                </form>

                <form
                    action="/admin/cases/reject/<%= scamCase.id %>"
                    method="POST"
                    style="display:inline;">

                    <button type="submit" class="btn btn-danger btn-sm">
                        ❌ Reject
                    </button>

                </form>

            </td>

        </tr>

    <% }) %>

</table>

<%# <Shawn End> %>
