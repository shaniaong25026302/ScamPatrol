// <Shawn Start>
<h1>Verify Scam Cases</h1>

<table class="table">

    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Platform</th>
        <th>Helpful</th>
        <th>Flags</th>
        <th>Action</th>
    </tr>

    <% cases.forEach(scamCase => { %>

        <tr>

            <td><%= scamCase.id %></td>
            <td><%= scamCase.title %></td>
            <td><%= scamCase.category_name || "N/A" %></td>
            <td><%= scamCase.platform || "N/A" %></td>
            <td><%= scamCase.helpful_count %></td>
            <td><%= scamCase.flag_count %></td>

            <td>
                <button>Approve</button>
                <button>Reject</button>
            </td>

        </tr>

    <% }) %>

</table>
// <Shawn End>
