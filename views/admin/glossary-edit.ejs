<%# <Shawn Start> %>

<h1>Edit Glossary Entry</h1>

<form action="/admin/glossary/edit/<%= glossary.id %>" method="POST">

    <label>Term</label><br>
    <input
        type="text"
        name="term"
        class="form-control"
        value="<%= glossary.term %>"
        required>

    <br>

    <label>Description</label><br>
    <textarea
        name="description"
        class="form-control"
        rows="6"
        required><%= glossary.description %></textarea>

    <br>

    <label>Prevention</label><br>
    <textarea
        name="prevention"
        class="form-control"
        rows="6"
        required><%= glossary.prevention %></textarea>

    <br>

    <button class="btn btn-primary">
        Save Changes
    </button>

</form>

<%# <Shawn End> %>