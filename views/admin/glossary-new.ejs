<%# <Shawn Start> %>

<h1>Add Glossary Entry</h1>

<form action="/admin/glossary/new" method="POST">

    <label>Term</label><br>
    <input
        type="text"
        name="term"
        class="form-control"
        required>

    <br>

    <div class="mb-3">
        <label class="form-label">Category</label>

        <select
            class="form-select"
            name="category"
            required
        >
            <option value="Phishing">Phishing</option>
            <option value="Investment">Investment</option>
            <option value="Romance">Romance</option>
            <option value="Banking">Banking</option>
            <option value="Government">Government</option>
            <option value="Job">Job</option>
            <option value="E-Commerce">E-Commerce</option>
        </select>
    </div>

    <label>Description</label><br>
    <textarea
        name="description"
        class="form-control"
        rows="6"
        required></textarea>

    <br>

    <label>Prevention</label><br>
    <textarea
        name="prevention"
        class="form-control"
        rows="6"
        required></textarea>

    <br>

    <button class="btn btn-primary">
        Create Entry
    </button>

</form>

<%# <Shawn End> %>