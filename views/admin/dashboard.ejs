<%# <Shawn Start> %>
<h1>Admin Dashboard</h1>

<p>Welcome, Administrator.</p>

<h2>Quick Overview</h2>

<div class="grid">

    <div class="card">
        <h2>👥 <%= totalUsers %></h2>
        <p>Total Users</p>
    </div>

    <div class="card">
        <h2>📂 <%= totalCases %></h2>
        <p>Scam Cases</p>
    </div>

    <div class="card">
        <h2>📚 <%= totalGlossary %></h2>
        <p>Glossary Entries</p>
    </div>

</div>

<hr>

<div class="grid">

    <a href="/admin/cases" class="feature-card-link">
        <div class="card" style="min-height: 240px;">
            <h2>📂 Verify Cases</h2>
            <p>Approve or reject scam reports submitted by users.</p>
        </div>
    </a>

    <a href="/admin/users" class="feature-card-link">
        <div class="card" style="min-height: 240px;">
            <h2>👤 Manage Users</h2>
            <p>View user accounts and assign roles.</p>
        </div>
    </a>

    <a href="/admin/reports" class="feature-card-link">
        <div class="card" style="min-height: 240px;">
            <h2>🚩 Flag Reports</h2>
            <p>Review inappropriate comments or reports.</p>
        </div>
    </a>

    <a href="/admin/glossary" class="feature-card-link">
        <div class="card" style="min-height: 240px;">
            <h2>📚 Scam Glossary</h2>
            <p>Create, edit and delete glossary entries.</p>
        </div>
    </a>

</div>
<%# <Shawn End> %>