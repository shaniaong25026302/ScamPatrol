<%# <Shania Start> %>
<!-- ===== Navbar ===== -->
<% const page = typeof activePage !== 'undefined' ? activePage : ''; %>
<% const navUser = typeof user !== 'undefined' ? user : null; %>
<nav class="navbar">
  <a href="/" class="brand"><span class="scam">scam</span><span class="lah">lah</span></a>
  <div class="links">
    <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
    <a href="/ai-checker" class="<%= page === 'ai-checker' ? 'active' : '' %>">AI Checker</a>
    <a href="/cases" class="<%= page === 'cases' ? 'active' : '' %>">Community Watch</a>
    <a href="/cases/new" class="<%= page === 'report' ? 'active' : '' %>">Report Scam</a>
    <!-- Teammates add their nav links here, additively -->

    <% if (navUser) { %>
      <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>"><%= navUser.username %></a>
      <a href="#" data-action="logout">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a>
      <a href="/auth/register" class="btn btn-primary">Register</a>
    <% } %>
  </div>
</nav>
<%# <Shania End> %>
