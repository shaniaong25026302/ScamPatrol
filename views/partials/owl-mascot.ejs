<%# <Shania Start> %>
<%# Inspector Hoot — the Scam Patrol HQ mascot. owlClass: '' | owl-state-happy | owl-state-alarm %>
<svg class="owl <%= typeof owlClass !== 'undefined' ? owlClass : '' %>" viewBox="0 0 200 200" role="img" aria-label="Inspector Hoot the owl">
  <!-- ear tufts -->
  <path d="M60 60 L48 24 L82 50 Z" fill="#b07f4f"/>
  <path d="M140 60 L152 24 L118 50 Z" fill="#b07f4f"/>
  <!-- body -->
  <ellipse cx="100" cy="118" rx="64" ry="70" fill="#c79a6b"/>
  <!-- wings -->
  <path d="M40 110 q-12 40 18 58 q-8 -34 4 -58 Z" fill="#b07f4f"/>
  <path d="M160 110 q12 40 -18 58 q8 -34 -4 -58 Z" fill="#b07f4f"/>
  <!-- belly -->
  <ellipse cx="100" cy="132" rx="40" ry="50" fill="#ecd7b4"/>
  <!-- facial disc -->
  <ellipse cx="100" cy="96" rx="54" ry="44" fill="#ecd7b4"/>
  <!-- detective fedora -->
  <ellipse cx="100" cy="50" rx="70" ry="13" fill="#4a3a2c"/>
  <path d="M62 50 q4 -34 38 -34 q34 0 38 34 Z" fill="#5b4636"/>
  <rect x="62" y="44" width="76" height="8" rx="4" fill="#3a2d22"/>
  <rect x="118" y="42" width="12" height="11" rx="2" fill="#caa23c"/>

  <!-- EYES: open (default) -->
  <g class="eye-open">
    <circle cx="80" cy="96" r="19" fill="#fff"/>
    <circle cx="120" cy="96" r="19" fill="#fff"/>
    <circle cx="82" cy="98" r="9" fill="#2a2018"/>
    <circle cx="122" cy="98" r="9" fill="#2a2018"/>
    <circle cx="85" cy="95" r="3" fill="#fff"/>
    <circle cx="125" cy="95" r="3" fill="#fff"/>
  </g>
  <!-- EYES: happy (^_^) -->
  <g class="eye-happy">
    <path d="M68 98 q12 -16 24 0" fill="none" stroke="#2a2018" stroke-width="5" stroke-linecap="round"/>
    <path d="M108 98 q12 -16 24 0" fill="none" stroke="#2a2018" stroke-width="5" stroke-linecap="round"/>
  </g>
  <!-- EYES: alarmed (wide + red ring) -->
  <g class="eye-alarm">
    <circle cx="80" cy="96" r="21" fill="#fff" stroke="#ff4d4d" stroke-width="3"/>
    <circle cx="120" cy="96" r="21" fill="#fff" stroke="#ff4d4d" stroke-width="3"/>
    <circle cx="80" cy="96" r="6" fill="#2a2018"/>
    <circle cx="120" cy="96" r="6" fill="#2a2018"/>
  </g>

  <!-- beak -->
  <path d="M100 108 L91 120 L109 120 Z" fill="#f0a637"/>
</svg>
<%# <Shania End> %>
