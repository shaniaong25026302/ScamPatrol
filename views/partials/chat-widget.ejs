<%# <Shania Start> %>
<% if (typeof user !== 'undefined' && user) { %>
<div class="hoot-widget">
  <button id="hoot-launcher" class="hoot-launcher" aria-label="Ask Inspector Hoot" title="Ask Inspector Hoot">
    <img src="/img/owl-mentor.png?v=2" alt="" class="pixel" />
    <span class="hoot-launcher-label">Ask&nbsp;Hoot</span>
  </button>

  <div id="hoot-panel" class="hoot-panel" hidden>
    <div class="hoot-head">
      <img src="/img/owl-mentor.png?v=2" alt="" class="pixel" />
      <div><b>Inspector Hoot</b><small>Anti-scam helper</small></div>
      <%# <Rebecca Member 2 Start> %>
      <div class="hoot-window-controls" aria-label="Chat window controls">
        <button
          id="hoot-maximize"
          class="hoot-window-btn"
          type="button"
          aria-label="Maximize chat"
          title="Maximize chat"
        >□</button>
        <button id="hoot-close" class="hoot-close" type="button" aria-label="Close chat" title="Close chat">✕</button>
      </div>
      <%# <Rebecca Member 2 End> %>
    </div>
    <!-- Shawn Start -->
    <div class="chat-history-panel">

        <div class="chat-history-header">

            <button
                id="toggle-history"
                class="chat-history-toggle"
                type="button">

                📜 Previous Chats ▼

            </button>

            <button
                type="button"
                id="new-chat-btn"
                class="gw-btn">

                New

            </button>

        </div>

        <div
            id="chat-history-list"
            class="chat-history-list"
            style="display:none;">

        </div>

    </div>
    <!-- Shawn End -->

    <!-- CG Start -->>
    <!-- Language Selector -->
    <div class="chat-language-panel">
      <label for="chat-language"><strong>🌐 Select Language:</strong></label>
      <select id="chat-language" name="language">
        <option value="en">English</option>
        <option value="zh">Chinese</option>
        <option value="ms">Malay</option>
        <option value="ta">Tamil</option>
        <option value="ja">Japanese</option>
        <option value="es">Spanish</option>
        <option value="ko">Korean</option>
      </select>
    </div>
    <!-- CG End -->
    
    <div class="chatbot" id="chatbot"></div>
    <div class="chatbot-quick" id="chatbot-quick">
      <button type="button" class="gw-chip" data-q="What is the anti-scam helpline number?">📞 Helpline?</button>
      <button type="button" class="gw-chip" data-q="I think I got scammed and already sent money. What do I do?">💸 I sent money</button>
      <button type="button" class="gw-chip" data-q="How do I spot a phishing SMS?">🎣 Phishing?</button>
    </div>
    <form id="chatbot-form" class="chatbot-input" autocomplete="off">
      <input type="text" id="chatbot-text" placeholder="Ask about scams…" maxlength="2000" />
      <%# <Rebecca Feature 3 Start> %>
      <button
        id="chatbot-mic"
        class="gw-btn voice-btn"
        type="button"
        aria-label="Hold to speak"
        title="Hold to speak"
      >🎙️</button>
      <span id="chatbot-voice-status" class="voice-status" aria-live="polite"></span>
      <%# <Rebecca Feature 3 End> %>
      <button class="gw-btn gold" type="submit" aria-label="Send">➤</button>
    </form>
    <%# <Rebecca Member 2 Start> %>
    <button
      id="hoot-resize-handle"
      class="hoot-resize-handle"
      type="button"
      aria-label="Resize chat window"
      title="Drag to resize chat"
    ></button>
    <%# <Rebecca Member 2 End> %>
  </div>
</div>
<script src="/js/chat-widget.js" defer></script>
<% } %>
<%# <Shania End> %>
