<%# <Shania Start> %>
<% const gp = typeof activePage !== 'undefined' ? activePage : ''; %>
<% const gu = typeof user !== 'undefined' ? user : null; %>

<header class="gw-topbar">
  <a href="/" class="gw-brand">
    <img src="/img/logo-cropped.png?v=3" alt="Scam Patrol HQ" class="logo pixel" />
  </a>

  <nav class="gw-nav">
    <% if (gu) { %>
      <a href="/hq" class="<%= gp === 'hq' ? 'active' : '' %>">HQ</a>
      <a href="/ai-checker" class="<%= gp === 'ai-checker' ? 'active' : '' %>">Analyzer</a>
      <a href="/missions" class="<%= gp === 'missions' ? 'active' : '' %>">Missions</a>
      <a href="/relationship" class="<%= gp === 'relationship' ? 'active' : '' %>">Long-Con</a>
      <a href="/dojo" class="<%= gp === 'dojo' ? 'active' : '' %>">Dojo</a>
      <a href="/shop" class="<%= gp === 'shop' ? 'active' : '' %>">Shop</a>
      <a href="/cases" class="<%= gp === 'cases' ? 'active' : '' %>">Community</a>
      <a href="/glossary" class="<%= gp === 'glossary' ? 'active' : '' %>">Glossary</a>
      <%# <Shawn Member 6 Start> %>
      <% if (gu && gu.role === "admin") { %>
        <a href="/admin" class="<%= gp === 'admin' ? 'active' : '' %>">Admin</a>
      <% } %>
      <%# <Shawn Member 6 End> %>
      <a href="/scam-weather" class="<%= gp === 'scam-weather' ? 'active' : '' %>">Scam Weather</a>
      <a href="/leaderboard" class="<%= gp === 'leaderboard' ? 'active' : '' %>">Ranks</a>
    <% } else { %>
      <%# Guests should only see Story. Scam Weather appears only after login. %>
      <a href="/" class="<%= gp === 'story' ? 'active' : '' %>">Story</a>
    <% } %>
  </nav>

  <div class="gw-mini-hud" id="mini-hud">
    <a href="#" id="snd-sfx" class="gw-chip" title="Sound effects" style="cursor:pointer">🔊</a>
    <a href="#" id="snd-music" class="gw-chip" title="Music" style="cursor:pointer;opacity:.4">🎵</a>

    <% if (gu) { %>
      <img src="/img/avatars/recruit.png" class="hud-avatar" id="hud-avatar" alt="avatar" />
      <span class="gw-chip"><span class="lvl">Lv <b id="hud-level">–</b></span></span>
      <span class="gw-chip energy-chip">
        <span><span class="energy">⚡</span> <b id="hud-energy">–</b></span>
        <small id="hud-energy-timer"></small>
      </span>
      <span class="gw-chip"><span class="coin">🪙</span> <b id="hud-coins">–</b></span>
      <span class="gw-chip"><span class="fire">🔥</span> <b id="hud-streak">–</b></span>
      <a href="#" data-action="logout" class="gw-btn ghost" style="padding:.4rem .8rem">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="gw-btn ghost" style="padding:.4rem .9rem">Log in</a>
      <a href="/auth/register" class="gw-btn" style="padding:.4rem .9rem">Sign up</a>
    <% } %>
  </div>
</header>
<%# <Shania End> %>