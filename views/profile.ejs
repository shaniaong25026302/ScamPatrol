<%# CG Member 4 Start %>
<section class="page-heading">
  <h1>My Profile</h1>
  <p>Manage your account details and see your activity.</p>
</section>
<section class="profile-header card">
  <img id="profile-avatar" src="/img/avatars/recruit.png" class="profile-avatar">

  <div class="profile-info">
    <h2 id="profile-name"><%= user.username %></h2>

    <p>
      Level <span id="profile-level">-</span> •
      <span id="profile-rank">Recruit</span>
    </p>

    <p>
      🪙 <span id="profile-coins">0</span>
      &nbsp;&nbsp;
      🔥 <span id="profile-streak">0</span>
    </p>
  </div>
</section>
<div class="card profile-card">
  <h2>Account Info</h2>
    <form action="/profile" method="POST">
      <label>Username</label><br>
        <input
            type="text"
            name="username"
            value="<%= user.username %>"
            style="width:100%;margin-bottom:15px;"
        >
        <label>Email</label><br>
        <input
            type="email"
            name="email"
            value="<%= user.email %>"
            style="width:100%;margin-bottom:15px;"
        >

        <label>Bio</label><br>
        <textarea
            name="bio"
            rows="4"
            style="width:100%;margin-bottom:15px;"
        ><%= user.bio || "" %></textarea>
        <button class="btn btn-primary" type="submit">
            Save Changes
        </button>
    </form>
    <form action="/auth/logout" method="POST" style="margin-top:20px;">
        <button class="btn btn-danger">
            Logout
        </button>
    </form>
</div>

<div class="card profile-comments">
  <h2>My Comments</h2>
  <% if (comments && comments.length > 0) { %>
    <% comments.forEach(c => { %>
      <div class="comment">
        <p><%= c.content %></p>
        <small>On case <%= c.case_id %> · <%= new Date(c.created_at).toLocaleString('en-SG') %></small>
      </div>
    <% }) %>
  <% } else { %>
    <p class="empty-state">You haven’t posted any comments yet.</p>
  <% } %>
</div>

<script src="/js/game-profile.js"></script>
<%# CG Member 4 End %>
