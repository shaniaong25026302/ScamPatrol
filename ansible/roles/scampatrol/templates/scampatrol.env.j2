# Managed by Ansible. Manual changes will be overwritten.
IMAGE_NAME={{ scampatrol_image | to_json }}

PORT={{ scampatrol_port }}
NODE_ENV={{ scampatrol_node_env | to_json }}
APP_BASE_URL={{ scampatrol_app_base_url | to_json }}

DB_HOST={{ scampatrol_db_host | to_json }}
DB_PORT={{ scampatrol_db_port }}
DB_USER={{ scampatrol_db_user | to_json }}
DB_PASSWORD={{ scampatrol_db_password | to_json }}
DB_NAME={{ scampatrol_db_name | to_json }}
DB_CONNECTION_LIMIT={{ scampatrol_db_connection_limit }}

JWT_SECRET={{ scampatrol_jwt_secret | to_json }}
JWT_EXPIRES_IN={{ scampatrol_jwt_expires_in | to_json }}
JWT_REFRESH_EXPIRES_IN={{ scampatrol_jwt_refresh_expires_in | to_json }}

GEMINI_API_KEY={{ scampatrol_gemini_api_key | default("") | to_json }}
GEMINI_MODEL={{ scampatrol_gemini_model | to_json }}
AI_FAKE={{ "1" if scampatrol_ai_fake else "0" }}

MAIL_FROM={{ scampatrol_mail_from | to_json }}
MAILJET_API_KEY={{ scampatrol_mailjet_api_key | to_json }}
MAILJET_SECRET_KEY={{ scampatrol_mailjet_secret_key | to_json }}
SMTP_HOST={{ scampatrol_smtp_host | to_json }}
SMTP_PORT={{ scampatrol_smtp_port }}
SMTP_USER={{ scampatrol_smtp_user | to_json }}
SMTP_PASS={{ scampatrol_smtp_pass | to_json }}

SCAM_WEATHER_REFRESH_MINUTES={{ scampatrol_weather_refresh_minutes }}
SCAM_WEATHER_SOURCE_TIMEOUT_MS={{ scampatrol_weather_source_timeout_ms }}

