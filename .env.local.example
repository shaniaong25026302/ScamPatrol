# ============================================================================
# Local development with the containerised database.
#
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.local.yml up
#
# This is the ONLY file you need to run the project. No filess.io account, no shared
# credentials, no setup: the compose file starts a MySQL container, loads db/schema.sql
# into it on first boot, and waits until it is genuinely ready before starting the app.
#
# Everything here is a throwaway value that exists on your machine only. Nothing in this
# file is or should ever be a real credential. The full list of settings the app
# understands is in .env.example.
# ============================================================================

# ── Database: the compose "db" service, not filess.io ────────────────────────
# DB_HOST is the SERVICE NAME, not localhost. Containers reach each other by service
# name on the compose network, and "localhost" inside the app container means the app
# container itself.
DB_HOST=db
# The INTERNAL port. The compose file also publishes 3307 on your machine so you can
# connect a GUI client, but from inside the network it is still the normal 3306.
DB_PORT=3306
DB_USER=scampatrol
DB_PASSWORD=local-dev-only
DB_NAME=scampatrol
DB_CONNECTION_LIMIT=4

# ── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=local-dev-only-not-a-real-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
# Blank means "secure only when NODE_ENV=production", which is right for local http.
COOKIE_SECURE=

# ── AI ───────────────────────────────────────────────────────────────────────
# 1 answers every AI request from the built-in offline heuristics and never calls the
# API, so local development needs no key and spends none of the shared free quota.
# Set it to 0 and add a key below only if you are specifically working on an AI feature.
AI_FAKE=1
GEMINI_API_KEYS=
GEMINI_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Email ────────────────────────────────────────────────────────────────────
# Leave blank locally. Password-reset emails simply will not send, which is fine.
MAIL_FROM=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Scam Weather ─────────────────────────────────────────────────────────────
SCAM_WEATHER_REFRESH_MINUTES=30
SCAM_WEATHER_SOURCE_TIMEOUT_MS=7000
